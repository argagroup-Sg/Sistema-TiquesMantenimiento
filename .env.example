# Vercel Postgres connection string
DATABASE_URL=postgres://USER:PASS@HOST:PORT/DBNAME

# NextAuth / JWT secrets
# Use NEXTAUTH_SECRET for NextAuth (recommended). JWT_SECRET is supported for compatibility.
NEXTAUTH_URL=http://localhost:3006
NEXTAUTH_SECRET=your-very-strong-random-secret
JWT_SECRET=your-very-strong-random-secret

# Optional: default password for seed scripts (scripts/create_users_bulk.js)
DEFAULT_USER_PASSWORD=TempPass123!
